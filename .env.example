# Provider selection: defaults to "ollama" (free, local) unless ANTHROPIC_API_KEY
# is set, in which case "anthropic" is used automatically. Set LLM_PROVIDER to
# force one explicitly.
# LLM_PROVIDER=ollama

# --- Anthropic (optional, higher-quality reasoning) ---
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (default, requires `brew install ollama && ollama pull qwen2.5:7b`) ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# PORT=4173
